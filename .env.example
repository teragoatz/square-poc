# Copy this file to .env and fill in your values.
# Never commit your real .env file – it's already in .gitignore.

# -----------------------------------------------------------------------
# Square API credentials
# -----------------------------------------------------------------------

# Your Square Access Token.
# For sandbox use the "Sandbox Access Token" from:
#   https://developer.squareup.com/apps → your app → Credentials (Sandbox)
# For production use the "Production Access Token".
SQUARE_ACCESS_TOKEN=your_sandbox_access_token_here

# Set to "sandbox" (default) or "production".
SQUARE_ENVIRONMENT=sandbox

# -----------------------------------------------------------------------
# Optional – used by the refunds demo
# -----------------------------------------------------------------------

# A COMPLETED payment ID to test refunds against.
# Run `npm run demo:payments` first and paste the payment ID here.
# SQUARE_PAYMENT_ID=
