{
  "name": "square-poc",
  "version": "1.0.0",
  "description": "TypeScript proof-of-concept demonstrating Square Payments API integration",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/index.ts",
    "demo:payments": "ts-node src/demos/payments-demo.ts",
    "demo:locations": "ts-node src/demos/locations-demo.ts",
    "demo:customers": "ts-node src/demos/customers-demo.ts",
    "demo:refunds": "ts-node src/demos/refunds-demo.ts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teragoatz/square-poc.git"
  },
  "keywords": [
    "square",
