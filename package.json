    "api",
    "typescript",
    "poc"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/teragoatz/square-poc/issues"
  },
  "homepage": "https://github.com/teragoatz/square-poc#readme",
  "dependencies": {
    "dotenv": "^17.3.1",
    "square": "^44.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.5",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
